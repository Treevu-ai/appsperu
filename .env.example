# Variables de entorno a nivel de shell/perfil de Windows usadas por .mcp.json
# en la raíz del repo. No hay .env propio en la raíz — esto documenta qué
# exportar en tu entorno, no un archivo que el repo cargue automáticamente.

# Usada por el server "neon-rastro-readonly" de .mcp.json (npx
# @modelcontextprotocol/server-postgres). Es una herramienta personal de
# exploración SQL de solo lectura contra Neon -- NO forma parte del servidor
# MCP oficial de Rastro (ese vive en mcp-server/, ver mcp-server/.env.example).
# Cadena de conexión Postgres de solo lectura al proyecto Neon de Rastro.
RASTRO_READONLY_URL=
