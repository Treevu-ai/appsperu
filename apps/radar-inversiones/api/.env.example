PORT=4002
WEB_ORIGIN=http://localhost:3002
DATABASE_URL=postgres://inversiones:inversiones@localhost:5434/radar_inversiones
EJECUCION_DATABASE_URL=postgres://radar:radar@localhost:5432/radar_ejecucion
# Alcance territorial del corte; separa departamentos con coma.
INVIERTE_DEPARTAMENTOS=LA LIBERTAD
INVIERTE_MAX_BYTES=52428800
# Solo para `npm run ingest:invierte:full`; debe ser un rango positivo y
# la corrida valida que cubra desde byte 0 hasta Content-Length sin huecos.
INVIERTE_CHUNK_BYTES=52428800
