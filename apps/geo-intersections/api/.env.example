# geo-intersections — variables de entorno
# Copiar a .env y ajustar

# Puerto del servidor
PORT=4037

# Postgres con PostGIS (ver docker-compose.yml)
DATABASE_URL=postgresql://geo_int:geo_int@localhost:5466/geo_intersections

#Fuentes — endpoints ArcGIS (sin trailing slash)
INGEMMET_ARCGIS_URL=https://geocatmin.ingemmet.gob.pe/arcgis/rest/services/SERV_CATASTRO_MINERO/MapServer/0
SERFOR_ARCGIS_BASE=https://geo.serfor.gob.pe/geoservicios/rest/services/Servicios_OGC

# SERFOR — capas a replicar (separadas por coma)
# Default: las 10 capas de Modalidad_Acceso y Ordenamiento_Forestal
SERFOR_LAYERS=modalidad_permisos,modalidad_cesiones_en_uso,modalidad_autorizaciones_pfdm_avnb,modalidad_autorizacion_cambio_uso_agropecuario,modalidad_bosques_locales,modalidad_unidad_aprovechamiento,modalidad_concesiones_forestales,ordenamiento_bosques_locales,ordenamiento_bosques_protectores,ordenamiento_bosques_produccion_permanente

# Batch — cuántas filas procesa el job de intersecciones por transaction
BATCH_SIZE=1000

# Límite de resultados en el endpoint de reporte
REPORT_LIMIT=500
