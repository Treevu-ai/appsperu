PORT=4049
WEB_ORIGIN=http://localhost:3030
DATABASE_URL=postgres://perdida_bosque:perdida_bosque@localhost:5464/perdida_bosque
# Solo necesaria para la base geo_intersections de donde se copian los
# límites administrativos (transfer-territories.ts) — no hace falta para
# correr la API normalmente.
SRC_TERRITORIES_DATABASE_URL=postgres://user:pass@host/geo_intersections
# API key de Global Forest Watch (data-api.globalforestwatch.org), generada
# a mano desde la cuenta propia del usuario — nunca generar/compartir la
# contraseña de la cuenta, solo esta key.
GFW_API_KEY=
