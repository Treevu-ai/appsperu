PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://radar:radar@localhost:5432/radar_ejecucion
MEF_DATA_FILENAME=2026-Gasto-Mensual.csv

# Enriquecimiento opcional de fichas sectoriales. Solo se consulta por CUI o
# entidad MEF exacta ya verificada; sin estas variables la respuesta declara la
# cobertura como no configurada y no usa coincidencias de nombres.
# INFOBRAS_DATABASE_URL=postgres://infobras:infobras@localhost:5432/infobras
# COMPRAS_DATABASE_URL=postgres://compras:compras@localhost:5432/compras_publicas
# IDENTIDAD_FISCAL_DATABASE_URL=postgres://fiscal:fiscal@localhost:5438/identidad_fiscal
# SANCIONES_DATABASE_URL=postgres://sanciones:sanciones@localhost:5439/proveedores_sancionados

# Ingesta comprensiva por departamento (PIA/PIM + devengado reales, no solo
# devengado) — ver docs/data-contracts/mef-presupuesto-ejecucion.md.
# Requiere MEF_FILTER_EJECUTORA_DEPARTAMENTO; usa SECTION_NIVEL_MES_BOUNDS
# (cualquier departamento del CSV, no solo LA LIBERTAD).
# MEF_INGESTA_ANIO_COMPLETO=true
# MEF_FILTER_EJECUTORA_DEPARTAMENTO=LA LIBERTAD

# Ingesta comprensiva de Gobierno Nacional dirigido a un departamento
# (DEPARTAMENTO_META, no sede) — cierra el blind spot de ADR-0006 (ej. gasto
# de reconstrucción/ANIN ejecutado desde Lima pero destinado a La Libertad,
# invisible en la ingesta de arriba). Offsets confirmados en vivo el
# 2026-08-21 para el bloque "GOBIERNO NACIONAL" completo — sirve para
# cualquier MEF_FILTER_DEPARTAMENTO, no solo La Libertad. Descarga ~1.47 GB
# en total (8 secciones mensuales completas, no ventanas angostas — ver
# comentario de NACIONAL_MES_START_BYTE en mef-connector.ts).
# MEF_INGESTA_META_DEPARTAMENTO=true
# MEF_FILTER_DEPARTAMENTO=LA LIBERTAD
