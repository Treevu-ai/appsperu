PORT=4100
WEB_ORIGIN=http://localhost:3011
DATABASE_URL=postgres://evidencia_cientifica:evidencia_cientifica@localhost:5443/evidencia_cientifica

# Pool cortés de CrossRef: con un email de contacto, CrossRef prioriza tus requests
# (ver https://api.crossref.org/swagger-ui/index.html#/Works/get_works). Opcional pero recomendado.
# CROSSREF_CONTACT_EMAIL=contacto@rastro.fyi

# Términos de búsqueda a ingerir, separados por coma. Por defecto: taxonomía de
# categorías de exportación no tradicional de CLI Market/Rastro.
# CROSSREF_QUERY_TERMS=cacao,cocoa,quinoa,quinua,maca,arandano,blueberry,aguaymanto,physalis,cafe especial peru
