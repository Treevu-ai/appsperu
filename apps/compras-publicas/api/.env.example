PORT=4001
WEB_ORIGIN=http://localhost:3001
DATABASE_URL=postgres://compras:compras@localhost:5433/compras_publicas
RADAR_DATABASE_URL=postgres://radar:radar@localhost:5432/radar_ejecucion
OECE_DEPARTAMENTO=LA LIBERTAD
OECE_MAX_PAGES=10
# Ruta CSV verificada de entidades para la fuente histórica de órdenes SEACE.
# Columnas: ruc,official_name,department,province,district,ubigeo.
# Nunca se infiere un RUC: cada fila debe estar verificada antes de una corrida.
# SEACE_LEGACY_ENTITY_CATALOG_PATH=C:\ruta\entidades-la-libertad.csv
# Tiempo máximo de una llamada saliente a una fuente pública, en milisegundos.
HTTP_TIMEOUT_MS=30000
# Proveedor OpenAI-compatible configurado explícitamente. No incluir secretos en este archivo.
# SEMANTIC_EMBEDDINGS_URL=http://127.0.0.1:11434/v1/embeddings
# SEMANTIC_EMBEDDINGS_MODEL=nomic-embed-text
# SEMANTIC_EMBEDDINGS_PROVIDER=local
# SEMANTIC_EMBEDDINGS_API_KEY=
# SEMANTIC_EMBEDDING_LIMIT=50
