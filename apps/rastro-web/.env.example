# Rastro Web — variables de entorno para DESARROLLO LOCAL.
# Copia este archivo a `.env` y ajusta si tus APIs corren en otros puertos
# o no están todas levantadas.
#
# Las URLs públicas de PRODUCCIÓN (api.rastro.pe) están protegidas con
# Cloudflare Access (Service Tokens) — ver docs/API_ACCESS_PROTECTION.md.
# El navegador en producción NO usa estas URLs (VITE_PUBLIC_APIS_LIVE=false
# en .env.production); la única excepción es la Cloudflare Function
# /api/search, que las lee desde el dashboard de Pages y agrega los
# headers `CF-Access-Client-Id` / `CF-Access-Client-Secret` antes de
# pegarle a api.rastro.pe.

# Puerto 4000
VITE_API_BASE_URL_RADAR_EJECUCION=http://localhost:4000
# Puerto 4001
VITE_API_BASE_URL_COMPRAS_PUBLICAS=http://localhost:4001
# Puerto 4002
VITE_API_BASE_URL_RADAR_INVERSIONES=http://localhost:4002
# Puerto 4003
VITE_API_BASE_URL_INFOBRAS=http://localhost:4003
# Puerto 4004
VITE_API_BASE_URL_CEPLAN_ESTRATEGICO=http://localhost:4004
# Puerto 4005
VITE_API_BASE_URL_CEPLAN_GEO=http://localhost:4005
# Puerto 4006
VITE_API_BASE_URL_IDENTIDAD_FISCAL=http://localhost:4006
# Puerto 4007
VITE_API_BASE_URL_SALUD_INSTITUCIONAL=http://localhost:4007
# Puerto 4008
VITE_API_BASE_URL_PROVEEDORES_SANCIONADOS=http://localhost:4008
# Puerto 4009
VITE_API_BASE_URL_ACTIVIDAD_AGRARIA=http://localhost:4009
# Puerto 4010
VITE_API_BASE_URL_SEGURIDAD_CIUDADANA=http://localhost:4010
# Puerto 4011
VITE_API_BASE_URL_BCRP_COMERCIO_EXTERIOR=http://localhost:4011
# Puerto 4012
VITE_API_BASE_URL_INVERSION_PRIVADA=http://localhost:4012
# Puerto 4013
VITE_API_BASE_URL_BCRP_LA_LIBERTAD=http://localhost:4013
