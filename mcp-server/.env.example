# DB separada para códigos de acceso sk-rastro-... (Fase 1). No es la DB de
# ninguna de las 27 apps — vive aparte por diseño (ver spec de API keys).
MCP_API_DATABASE_URL=postgres://mcp_keys:mcp_keys@localhost:5436/rastro_keys

# Opcional. Si se define, el servidor exige un código válido al arrancar y
# aplica el presupuesto de queries en cada llamada a rastro_llamar. Sin
# definir (default), el servidor funciona exactamente igual que antes de
# esta capa — sin auth, sin depender de Postgres para nada.
# MCP_API_KEY=sk-rastro-...
