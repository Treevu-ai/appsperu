# Dependencias y build artifacts (cualquier app del monorepo)
node_modules/
.next/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Env locales (cada app declara los suyos si necesita excepciones)
.env
.env.local
.mcp.json

# Secretos y material de sesion — nunca al historial del repo publico
mcp-server/generated-keys/
bcrp_cookies.json
bcrp_session*.json
bcrp_test.json
*_cookies.json
*_session*.json

# Logs y artefactos operativos
logs/
*.log

# Automatización / debug de navegador
.playwright-cli/
.wrangler/

# OS / editor
.DS_Store
*.sw?

# Bloqueos de Office — el archivo temporal ~$*.docx se crea al abrir el
# documento en Word y jamás debe versionarse
~$*.docx
~$*.xlsx
~$*.pptx

# Worktrees de git usados para desarrollo en paralelo (no son contenido del repo)
.worktrees/

# Python (tools/ckan-indexer, tools/scrapers)
__pycache__/
*.pyc

# Dumps de consulta y scratch local de depuracion — salidas de una sesion de
# trabajo, no codigo fuente ni artefactos de despliegue
/docs/out_*.txt
/docs/err_*.txt
/docs/ocds_*.txt
/docs/search_*.mjs
/docs/find_ocds_ids.mjs
/tmp_*.py
/tmp_*.js
/agg_*.py
/aggregate_*.py
/check_*.py
/query_*.py
/query_*.js
/bcrp_fetch.js
/find_bad_chars.py
/make_pdf.py
/html_to_pdf.js
/run_vitest.ps1
/dy
/tools/test_gpp.py
/tools/test_gpp.ps1

# Caché y salidas locales de tools/scrapers y tools/ckan-indexer — datos
# descargados/generados, no código fuente, no se versionan
tools/scrapers/cache/
tools/scrapers/reports/
tools/ckan-indexer/state/

# Borradores locales de financiamiento — cifras y estrategia institucional,
# nunca al historial del repo publico (ver docs/financiamiento/README.md)
docs/financiamiento/
.neon

# Notas internas y carpeta personal que el propio material marcaba como
# fuera del repo publico (reports/ y research_notes/ figuraban como untracked;
# acuba/ es material de trabajo local). No volver a versionarlas.
/reports/
/research_notes/
/acuba/

# Postulaciones con presupuesto (concurso UP, Hinrich y la propuesta general)
# y los scripts que solo las regeneran. El codigo, los papers y el anexo
# tecnico de investigaciones/ si se versionan.
/investigaciones/rca-shift-share-cptpp-china/propuesta/UP-XI-Concurso-Propuesta-Gobernanza-Exportaciones-ES.*
/investigaciones/rca-shift-share-cptpp-china/propuesta/Hinrich-Proposal-Governance-Trade-Peru-EN.*
/investigaciones/rca-shift-share-cptpp-china/propuesta/Propuesta-Proyecto-Gobernanza-Exportaciones.*
