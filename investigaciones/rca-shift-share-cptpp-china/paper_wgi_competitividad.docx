\section{Figura C1: Distribución de WGI promedio (2015-2024)}

\begin{figure}[H]
\centering
\includegraphics[width=\textwidth]{fig_wgi_distribution.png}
\caption{Distribución de los indicadores WGI promedios (2015-2024) para los 184 socios comerciales de Perú. El valor de Perú está marcado con una línea vertical discontinua. Perú se encuentra en el cuartil inferior de control de corrupción pero en el cuartil medio-alto de estabilidad política, reflejando el patrón mixto de gobernanza institucional en el país.}
\label{fig:wgi-distribution}
\end{figure}

\noindent \textit{Nota: La figura requeriría generación gráfica. El archivo de datos wdi\_wgi.csv contiene los valores necesarios para recrear este histograma/barras.}

